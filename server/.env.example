# ─────────────────────────────────────────────────────────────────────────────
#  SCIENTIFIC FILES — server environment
#  Copy to `server/.env` and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# API server
NODE_ENV=development
PORT=5000

# Public URL of the React client (used for CORS + cookie handling)
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/scientific-files
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scientific-files?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/scientific-files

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-64-byte-random-string
JWT_EXPIRES_IN=2h

# ── First admin account (used by `npm run seed:admin`) ───────────────────────
# Tip: wrap values in double quotes if they contain # or spaces,
#      e.g. ADMIN_PASSWORD="My#Secret1"  (a bare # starts a comment).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Video storage ────────────────────────────────────────────────────────────
# STORAGE_PROVIDER: cloudinary | local
#   cloudinary -> production object storage (large files, CDN delivery)
#   local     -> development fallback, files are written to server/uploads
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=scientific-files

# ── Upload limits ────────────────────────────────────────────────────────────
MAX_VIDEO_SIZE_MB=200

# ── Rate limiting (public code verification) ─────────────────────────────────
VERIFY_RATE_LIMIT_MAX=20
VERIFY_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Set to "true" only when the API and client are served over HTTPS
COOKIE_SECURE=false